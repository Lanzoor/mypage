{
    "name": "core-svelte",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm generate && vite dev",
        "build": "pnpm generate && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "generate": "pnpm generate:blog && pnpm generate:changelog",
        "generate:blog": "tsx scripts/generate:blog.ts",
        "generate:changelog": "tsx scripts/generate:changelog.ts"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^26.1.1",
        "prettier": "^3.9.1",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "decimal.js": "^10.6.0",
        "katex": "^0.18.1"
    },
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
