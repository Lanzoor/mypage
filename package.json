        "prettier": "^3.9.1",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "decimal.js": "^10.6.0",
        "katex": "^0.18.1"
    }
